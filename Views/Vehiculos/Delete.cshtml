@model Vehiculo

@{
    ViewData["Title"] = "Eliminar vehículo";
}

<h1>Eliminar vehículo</h1>

<div class="alert alert-warning">¿Desea eliminar este vehículo? Esta acción no se puede deshacer.</div>

<p><strong>@Model.ObtenerResumen()</strong></p>

<form asp-action="Delete" method="post">
    <input type="hidden" name="placa" value="@Model.Placa" />

    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
