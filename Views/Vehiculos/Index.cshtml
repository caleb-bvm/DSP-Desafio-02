@model List<Vehiculo>

@{
    ViewData["Title"] = "Vehículos";
}

<div class="page-heading">
    <div>
        <h1>Vehículos de la flota</h1>
        <p class="text-muted mb-0">Consulte y administre los vehículos registrados.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Registrar vehículo</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<p class="fleet-count">Total de vehículos registrados: <strong>@Model.Count</strong></p>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>Su flota comienza aquí</h2>
        <p class="text-muted mb-0">No hay vehículos registrados. Use «Registrar vehículo» para agregar el primero.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Tipo</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Año</th>
                    <th>Kilometraje</th>
                    <th>Mantenimiento anual (USD)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehiculo in Model)
                {
                    <tr>
                        <td class="vehicle-plate">@vehiculo.Placa</td>
                        <td>
                            @if (vehiculo is Camion)
                            {
                                <span>Camión</span>
                            }
                            else if (vehiculo is Automovil)
                            {
                                <span>Automóvil</span>
                            }
                            else if (vehiculo is Motocicleta)
                            {
                                <span>Motocicleta</span>
                            }
                        </td>
                        <td>@vehiculo.Marca</td>
                        <td>@vehiculo.Modelo</td>
                        <td>@vehiculo.Anio</td>
                        <td>@vehiculo.Kilometraje.ToString("N2")</td>
                        <td>
                            @vehiculo.CalcularCostoMantenimiento().ToString("N2")
                        </td>
                        <td class="vehicle-actions">
                            <a asp-action="Details"
                               asp-route-placa="@vehiculo.Placa" class="btn btn-sm btn-outline-primary">Detalle</a>
                            <a asp-action="Edit"
                               asp-route-placa="@vehiculo.Placa" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <a asp-action="Delete"
                               asp-route-placa="@vehiculo.Placa" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
